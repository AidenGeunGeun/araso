#!/bin/sh
# The old Seamtype keeps running while the payload is copied (no preinstall stops it: macOS would
# only start the old code again). Stop it now, then register the new copy for the logged-in user
# if it isn't registered yet (the installer runs this as root) and refresh the input menu. Adding
# it in System Settings → Keyboard → Input Sources may still be needed; never fail the install.
app="/Library/Input Methods/Seamtype.app"
# SIGTERM, then SIGKILL whatever is left, and wait until it is gone (as vChewing's installer does):
# a Seamtype still running would keep the old code, and registering may start one.
pkill -x Seamtype 2>/dev/null || true
i=0; while pgrep -x Seamtype >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
pkill -9 -x Seamtype 2>/dev/null || true
i=0; while pgrep -x Seamtype >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != root ]; then
  uid=$(id -u "$user")
  # A copy get.sh or install.sh put in ~/Library/Input Methods is the same input method twice, and
  # macOS may launch that one: the package's copy replaces it (settings live elsewhere and stay).
  home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  if [ -n "$home" ] && [ -d "$home/Library/Input Methods/Seamtype.app" ]; then
    launchctl asuser "$uid" sudo -u "$user" /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$home/Library/Input Methods/Seamtype.app" 2>/dev/null || true
    rm -rf "$home/Library/Input Methods/Seamtype.app"
  fi
  launchctl asuser "$uid" sudo -u "$user" "$app/Contents/MacOS/Seamtype" --register || true
  launchctl asuser "$uid" sudo -u "$user" killall TextInputMenuAgent 2>/dev/null || true
  # The switch indicator by the caret keeps the icon it read first (they ignore SIGTERM).
  launchctl asuser "$uid" sudo -u "$user" killall -KILL CursorUIViewService TextInputSwitcher 2>/dev/null || true
fi
exit 0
